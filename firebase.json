{
  "hosting": {
    "site": "blog-sucupira",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/sucupira-para-articulacoes-dor-nas-juntas/?$",
        "destination": "/sucupira-para-articulacoes/",
        "type": 301
      },
      {
        "regex": "^/sucupira-com-remedio-para-pressao-e-seguro-tomar-junto/?$",
        "destination": "/sucupira-e-pressao-alta/",
        "type": 301
      },
      {
        "regex": "^/sucupira-liquida-e-melhor-que-capsula-para-dor/?$",
        "destination": "/cha-de-sucupira-capsula-ou-extrato/",
        "type": 301
      },
      {
        "regex": "^/o-que-tomar-para-dor-na-lombar/?$",
        "destination": "/dor-lombar-o-que-fazer/",
        "type": 301
      },
      {
        "regex": "^/nervo-ciatico-inflamado-o-que-fazer/?$",
        "destination": "/sucupira-para-nervo-ciatico/",
        "type": 301
      },
      {
        "regex": "^/sucupira-funciona-mesmo/?$",
        "destination": "/sucupira-alivia-dores-cronicas-o-que-a-ciencia-diz/",
        "type": 301
      },
      {
        "regex": "^/blog/sucupira-para-articulacoes-dor-nas-juntas/?$",
        "destination": "/sucupira-para-articulacoes/",
        "type": 301
      },
      {
        "regex": "^/blog/sucupira-com-remedio-para-pressao-e-seguro-tomar-junto/?$",
        "destination": "/sucupira-e-pressao-alta/",
        "type": 301
      },
      {
        "regex": "^/blog/sucupira-liquida-e-melhor-que-capsula-para-dor/?$",
        "destination": "/cha-de-sucupira-capsula-ou-extrato/",
        "type": 301
      },
      {
        "regex": "^/blog/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/blog/(?P<slug>.+)$",
        "destination": "/:slug",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap-index.xml"
      }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
