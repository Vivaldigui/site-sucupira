---
import StoreFooterBanner from "../components/StoreFooterBanner.astro";
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import LinkTracking from '../components/LinkTracking.astro';
import FirstPartyTracking from '../components/FirstPartyTracking.astro';
import WebVitalsTracking from '../components/WebVitalsTracking.astro';
import ProductCTA from '../components/ProductCTA.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  AUTHOR_ID,
  AUTHOR_JOB_TITLE,
  AUTHOR_NAME,
  BLOG_NAME,
  ORGANIZATION_ID,
  CONTACT_PAGE_PATH,
  PRIVACY_PAGE_PATH,
  SALES_CTA_URL,
  SALES_SITE_URL,
  SITE_NAME,
  WEBSITE_ID,
  blogUrl,
} from '../consts';
import '../styles/blog.css';

const canonicalUrl = blogUrl('/sobre/');
const title = `Quem somos | ${BLOG_NAME}`;
const description =
  'A Sucupira Naturale é uma empresa familiar desde 2016.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: SITE_NAME,
      url: SALES_SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: blogUrl('/assets/logo.png'),
      },
      founder: { '@id': AUTHOR_ID },
    },
    {
      '@type': 'Person',
      '@id': AUTHOR_ID,
      name: AUTHOR_NAME,
      jobTitle: AUTHOR_JOB_TITLE,
      description: 'Engenheira agrônoma e cofundadora da Sucupira Naturale, empresa familiar desde 2016.',
      image: blogUrl('/assets/priscila-petrucelli.webp'),
      url: canonicalUrl,
      worksFor: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'AboutPage',
      '@id': `${canonicalUrl}#about`,
      name: 'Quem somos',
      description,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: BLOG_NAME,
          item: blogUrl('/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Quem somos',
          item: canonicalUrl,
        },
      ],
    },
  ],
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={BLOG_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <GoogleAnalytics contentGroup="institucional" />
    <LinkTracking />
    <FirstPartyTracking />
    <WebVitalsTracking />
    <script type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <SiteHeader />

    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <ol>
        <li><a href="/">{BLOG_NAME}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Quem somos</li>
      </ol>
    </nav>

    <main class="blog-container">
      <article>
        <div class="article-body">
          <h1>Quem somos</h1>

          <p>A Sucupira Naturale é uma empresa familiar desde 2016.</p>

          <p>A Sucupira Naturale é um extrato vegetal, um produto tradicional brasileiro. Não é remédio, não é tratamento médico e não substitui tratamento médico.</p>
        </div>

        <ProductCTA
          title="Quer conhecer a Sucupira Naturale?"
          text="Consulte opções e condições na página oficial de venda."
          label="Acessar página oficial"
        />
      </article>
    </main>

    <footer class="blog-footer">
      <StoreFooterBanner />
      <p>© 2016–{new Date().getFullYear()} Sucupira Naturale — Todos os direitos reservados.</p>
      <p>
        <a href="/">{BLOG_NAME}</a> · <a href={CONTACT_PAGE_PATH}>Contato</a> ·
        <a href={PRIVACY_PAGE_PATH}>Política de Privacidade</a> ·
        <a href={SALES_CTA_URL}>Acessar a página oficial do produto</a>
      </p>
    </footer>
  </body>
</html>
