---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BlogHero from '../components/BlogHero.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Pagination from '../components/Pagination.astro';
import PostSearch from '../components/PostSearch.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  BLOG_NAME,
  BLOG_SITE_URL,
  DEFAULT_OG_IMAGE,
  ORGANIZATION_ID,
  SALES_CTA_URL,
  SALES_SITE_URL,
  SITE_NAME,
  WEBSITE_ID,
  blogUrl,
} from '../consts';
import '../styles/blog.css';
import { getPublishedPosts, paginatePosts, toSearchIndexEntry } from '../utils/posts';

const defaultCardImage = '/assets/sucupira-natural-banner.webp';

const posts = getPublishedPosts(await getCollection('blog'));
const { items: pagePosts, currentPage, totalPages } = paginatePosts(posts, 1);
const searchIndex = posts.map((post) => toSearchIndexEntry(post, defaultCardImage));

const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .map((name) => ({
    name,
    count: posts.filter((post) => post.data.tags.includes(name)).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'pt-BR'));

const canonicalUrl = blogUrl('/');
const title = `${BLOG_NAME} | ${SITE_NAME}`;
const description =
  'Conteúdo educativo sobre sucupira: formas de uso, evidências disponíveis e cuidados, por Priscila Petrucelli, cofundadora da Sucupira Naturale.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: SITE_NAME,
      url: SALES_SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: blogUrl('/assets/logo.png'),
      },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: BLOG_NAME,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      publisher: { '@id': ORGANIZATION_ID },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${BLOG_SITE_URL}/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      name: BLOG_NAME,
      description,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': WEBSITE_ID },
      about: tags.map((tag) => tag.name),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: posts.length,
        itemListElement: pagePosts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: blogUrl(`/${post.slug}/`),
          name: post.data.title,
        })),
      },
    },
  ],
});

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={DEFAULT_OG_IMAGE} />
    <meta property="og:image:alt" content="Extrato de sucupira da Sucupira Naturale" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={DEFAULT_OG_IMAGE} />
    <meta name="twitter:image:alt" content="Extrato de sucupira da Sucupira Naturale" />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <GoogleAnalytics />
    <script type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <SiteHeader />
    <BlogHero />

    <main class="knowledge-main">
      <PostSearch posts={searchIndex} totalCount={posts.length} />

      <section aria-labelledby="articles-title">
        <h2 id="articles-title" class="visually-hidden">Artigos publicados</h2>
        {posts.length === 0 ? (
          <p class="empty-state">Nenhum artigo publicado ainda.</p>
        ) : (
          <div class="posts-grid" id="posts-grid">
            {pagePosts.map((post) => (
              <ArticleCard
                slug={post.slug}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                publishDate={post.data.publishDate}
                image={post.data.ogImage || defaultCardImage}
              />
            ))}
          </div>
        )}
        <Pagination currentPage={currentPage} totalPages={totalPages} />
      </section>
    </main>

    <footer class="blog-footer">
      <p>© 2016–{new Date().getFullYear()} Sucupira Naturale — Todos os direitos reservados.</p>
      <p><a href="/sobre/">Quem somos</a> · <a href={SALES_CTA_URL}>Acessar a página oficial do produto</a></p>
    </footer>
  </body>
</html>
