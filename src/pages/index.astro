---
import StoreFooterBanner from "../components/StoreFooterBanner.astro";
import BlogHero from '../components/BlogHero.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import LinkTracking from '../components/LinkTracking.astro';
import FirstPartyTracking from '../components/FirstPartyTracking.astro';
import WebVitalsTracking from '../components/WebVitalsTracking.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  BLOG_NAME,
  BLOG_SITE_URL,
  DEFAULT_OG_IMAGE,
  ORGANIZATION_ID,
  CONTACT_PAGE_PATH,
  PRIVACY_PAGE_PATH,
  SALES_CTA_URL,
  SALES_SITE_URL,
  SITE_NAME,
  WEBSITE_ID,
  blogUrl,
} from '../consts';
import '../styles/blog.css';

const canonicalUrl = blogUrl('/');
const title = `${BLOG_NAME} | ${SITE_NAME}`;
const description =
  'A Sucupira Naturale é um extrato vegetal, um produto tradicional brasileiro. Não é remédio, não é tratamento médico e não substitui tratamento médico.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: SITE_NAME,
      url: SALES_SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: blogUrl('/assets/logo.png'),
      },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: BLOG_NAME,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      publisher: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      name: BLOG_NAME,
      description,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': WEBSITE_ID },
    },
  ],
});

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={BLOG_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={DEFAULT_OG_IMAGE} />
    <meta property="og:image:alt" content="Extrato de sucupira da Sucupira Naturale" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={DEFAULT_OG_IMAGE} />
    <meta name="twitter:image:alt" content="Extrato de sucupira da Sucupira Naturale" />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <GoogleAnalytics contentGroup="listagem" />
    <LinkTracking />
    <FirstPartyTracking />
    <WebVitalsTracking />
    <script type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <SiteHeader />
    <BlogHero />

    <main class="knowledge-main">
      <p>A Sucupira Naturale é um extrato vegetal, um produto tradicional brasileiro. Não é remédio, não é tratamento médico e não substitui tratamento médico.</p>
      <p><a href={SALES_CTA_URL}>Conhecer a Sucupira Naturale na loja</a></p>
    </main>

    <footer class="blog-footer">
      <StoreFooterBanner />
      <p>© 2016–{new Date().getFullYear()} Sucupira Naturale — Todos os direitos reservados.</p>
      <p>
        <a href="/sobre/">Quem somos</a> · <a href={CONTACT_PAGE_PATH}>Contato</a> ·
        <a href={PRIVACY_PAGE_PATH}>Política de Privacidade</a> ·
        <a href={SALES_CTA_URL}>Acessar a página oficial do produto</a>
      </p>
    </footer>
  </body>
</html>
