---
import AdSense from '../components/AdSense.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import LinkTracking from '../components/LinkTracking.astro';
import WebVitalsTracking from '../components/WebVitalsTracking.astro';
import InfoBox from '../components/InfoBox.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  AUTHOR_ID,
  AUTHOR_NAME,
  AUTHOR_PAGE_PATH,
  BLOG_NAME,
  COMPANY_CITY,
  COMPANY_CNPJ,
  COMPANY_LEGAL_NAME,
  COMPANY_STATE,
  CONTACT_EMAIL,
  CONTACT_PAGE_PATH,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_E164,
  CONTACT_WHATSAPP_URL,
  ORGANIZATION_ID,
  PRIVACY_PAGE_PATH,
  SALES_CTA_URL,
  SALES_SITE_URL,
  SITE_NAME,
  TECHNICAL_MANAGER,
  TECHNICAL_MANAGER_LICENSE,
  WEBSITE_ID,
  blogUrl,
} from '../consts';
import '../styles/blog.css';

const canonicalUrl = blogUrl(CONTACT_PAGE_PATH);
const title = `Contato | ${SITE_NAME}`;
const description =
  'Fale com a Sucupira Naturale: telefone e WhatsApp (35) 99169-6906, e-mail atendimento@sucupiranaturale.com.br. Empresa familiar de Itanhandu (MG), CNPJ 10.230.957/0001-88.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: SITE_NAME,
      legalName: COMPANY_LEGAL_NAME,
      taxID: COMPANY_CNPJ,
      url: SALES_SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: blogUrl('/assets/logo.png'),
      },
      email: CONTACT_EMAIL,
      telephone: CONTACT_PHONE_E164,
      founder: { '@id': AUTHOR_ID },
      address: {
        '@type': 'PostalAddress',
        addressLocality: COMPANY_CITY,
        addressRegion: COMPANY_STATE,
        addressCountry: 'BR',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          telephone: CONTACT_PHONE_E164,
          email: CONTACT_EMAIL,
          availableLanguage: ['Portuguese'],
          areaServed: 'BR',
        },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${canonicalUrl}#contact`,
      name: 'Contato',
      description,
      url: canonicalUrl,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: BLOG_NAME,
          item: blogUrl('/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contato',
          item: canonicalUrl,
        },
      ],
    },
  ],
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <AdSense />
    <GoogleAnalytics contentGroup="institucional" />
    <LinkTracking />
    <WebVitalsTracking />
    <script type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <SiteHeader />

    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <ol>
        <li><a href="/">Centro de Conhecimento</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Contato</li>
      </ol>
    </nav>

    <main class="blog-container">
      <article>
        <div class="article-body">
          <h1>Contato</h1>

          <p>
            Somos uma empresa familiar de Itanhandu, em Minas Gerais, e o atendimento é feito por gente — não
            por robô. Se você tem uma dúvida sobre o produto, sobre um pedido ou sobre algo que leu aqui no
            blog, fale com a gente por um dos canais abaixo.
          </p>

          <h2 id="canais">Canais de atendimento</h2>

          <ul>
            <li>
              <strong>Telefone e WhatsApp:</strong>
              <a href={`tel:${CONTACT_PHONE_E164}`}>{CONTACT_PHONE_DISPLAY}</a> ·
              <a href={CONTACT_WHATSAPP_URL} rel="nofollow noopener">Abrir conversa no WhatsApp</a>
            </li>
            <li>
              <strong>E-mail:</strong> <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </li>
          </ul>

          <p>
            Respondemos em dias úteis, no horário comercial. Para agilizar, diga logo na primeira mensagem se a
            sua dúvida é sobre um <strong>pedido</strong> (nesse caso, tenha o número em mãos), sobre o
            <strong>produto</strong> ou sobre um <strong>artigo do blog</strong>.
          </p>

          <h2 id="assuntos">Qual canal usar para cada assunto</h2>

          <ul>
            <li>
              <strong>Pedidos, pagamento, entrega, troca e devolução:</strong> esses assuntos são resolvidos
              pela loja oficial. O caminho mais rápido é o WhatsApp acima ou a
              <a href={SALES_CTA_URL} rel="nofollow">página oficial do produto</a>.
            </li>
            <li>
              <strong>Dúvidas sobre uso, composição ou contraindicações:</strong> pode perguntar por qualquer
              canal. Só lembre que a nossa resposta é informativa e não substitui a orientação de um
              profissional de saúde que conheça o seu caso.
            </li>
            <li>
              <strong>Correções, sugestões de pauta e uso de conteúdo do blog:</strong> escreva para o e-mail.
              Se você encontrou um erro em algum artigo, indique o link — corrigimos e registramos a correção.
            </li>
            <li>
              <strong>Imprensa e parcerias editoriais:</strong> pelo e-mail, com o assunto identificado.
            </li>
            <li>
              <strong>Privacidade e proteção de dados:</strong> pedidos de acesso, correção ou exclusão de
              dados pessoais devem ir para o e-mail acima. O detalhamento está na
              <a href={PRIVACY_PAGE_PATH}>Política de Privacidade</a>.
            </li>
          </ul>

          <h2 id="quem-responde">Quem responde</h2>

          <table>
            <tbody>
              <tr>
                <th scope="row">Marca</th>
                <td>{SITE_NAME}</td>
              </tr>
              <tr>
                <th scope="row">Razão social</th>
                <td>{COMPANY_LEGAL_NAME}</td>
              </tr>
              <tr>
                <th scope="row">CNPJ</th>
                <td>{COMPANY_CNPJ}</td>
              </tr>
              <tr>
                <th scope="row">Sede</th>
                <td>{COMPANY_CITY} ({COMPANY_STATE}), Brasil</td>
              </tr>
              <tr>
                <th scope="row">Responsável técnica</th>
                <td>{TECHNICAL_MANAGER} — {TECHNICAL_MANAGER_LICENSE}</td>
              </tr>
              <tr>
                <th scope="row">Autoria do blog</th>
                <td>
                  <a href={AUTHOR_PAGE_PATH}>{AUTHOR_NAME}</a>, engenheira agrônoma e cofundadora
                </td>
              </tr>
            </tbody>
          </table>

          <InfoBox
            variant="disclaimer"
            title="O atendimento não é consulta"
            labelledBy="contact-disclaimer-title"
          >
            <p>
              <strong>Nosso atendimento é comercial e informativo, não clínico.</strong> Não fazemos
              diagnóstico, não indicamos tratamento e não avaliamos exames. Se você usa medicamentos de uso
              contínuo, está grávida ou amamentando, ou tem alguma condição de saúde, converse com o seu médico
              ou farmacêutico antes de usar qualquer suplemento.
            </p>
          </InfoBox>
        </div>
      </article>
    </main>

    <footer class="blog-footer">
      <p>© 2016–{new Date().getFullYear()} Sucupira Naturale — Todos os direitos reservados.</p>
      <p>
        <a href="/">Centro de Conhecimento</a> · <a href={AUTHOR_PAGE_PATH}>Quem somos</a> ·
        <a href={PRIVACY_PAGE_PATH}>Política de Privacidade</a> ·
        <a href={SALES_CTA_URL}>Acessar a página oficial do produto</a>
      </p>
    </footer>
  </body>
</html>
