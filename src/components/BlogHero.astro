---
import { BLOG_NAME, SALES_CTA_URL } from '../consts';
---

<section class="blog-hero" aria-labelledby="page-title">
  <img
    class="blog-hero-media"
    src="/assets/sucupira-natural-banner.webp"
    alt="Garrafas da Sucupira Naturale sobre sementes de sucupira"
    width="1200"
    height="928"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="blog-hero-shade" aria-hidden="true"></div>
  <div class="blog-hero-content">
    <p class="eyebrow">Conteúdo informativo</p>
    <h1 id="page-title">{BLOG_NAME}</h1>
    <p>
      Empresa familiar desde 2016.
    </p>
    <div class="hero-actions">
      <a href={SALES_CTA_URL} class="hero-cta">Conhecer o produto</a>
      <span>Não é remédio, não é tratamento médico e não substitui tratamento médico.</span>
    </div>
  </div>
</section>
