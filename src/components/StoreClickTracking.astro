---
// Mede o clique do blog para a loja — a métrica que liga SEO a venda.
// Envia um evento GA4 `clique_para_loja` por artigo e por posição de CTA,
// para responder "qual artigo manda gente para a loja" sem depender de
// referrer, que se perde em boa parte dos navegadores.
import { SALES_SITE_URL } from '../consts';

const storeHost = new URL(SALES_SITE_URL).hostname.replace(/^www\./, '');

const trackingScript = `
(function () {
  var STORE_HOST = ${JSON.stringify(storeHost)};

  function isStoreLink(anchor) {
    if (!anchor || !anchor.href) return false;
    try {
      var host = new URL(anchor.href, window.location.href).hostname.replace(/^www\\./, '');
      return host === STORE_HOST || host.endsWith('.' + STORE_HOST);
    } catch (error) {
      return false;
    }
  }

  // Onde na página o leitor clicou. Serve para saber qual CTA puxa o clique.
  function ctaPosition(anchor) {
    if (anchor.closest('.blog-header')) return 'cabecalho';
    if (anchor.closest('.blog-footer')) return 'rodape';
    if (anchor.closest('.product-cta')) return 'bloco-cta';
    if (anchor.closest('.mobile-sticky-cta')) return 'barra-fixa';
    if (anchor.closest('.article-body')) return 'corpo-do-texto';
    return 'outro';
  }

  function handle(event) {
    var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
    if (!isStoreLink(anchor)) return;
    if (typeof window.gtag !== 'function') return;

    var destino = new URL(anchor.href, window.location.href);

    window.gtag('event', 'clique_para_loja', {
      destino_url: destino.href,
      destino_path: destino.pathname,
      origem_path: window.location.pathname,
      origem_titulo: document.title,
      posicao_cta: ctaPosition(anchor),
      texto_link: (anchor.textContent || '').trim().slice(0, 100),
    });
  }

  document.addEventListener('click', handle, true);
  document.addEventListener('auxclick', handle, true);
})();
`;
---

<script is:inline set:html={trackingScript}></script>
