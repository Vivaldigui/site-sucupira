---
// Core Web Vitals medidos nos leitores reais — LCP, INP e CLS — por página.
// O Search Console agrega esse dado por grupo de URL; aqui ele sai por artigo e
// por grupo de conteúdo, o que permite achar a página lenta em vez do grupo lento.
//
// Evento `web_vitals` { metric_name, metric_value, metric_rating, metric_id },
// enviado só para a propriedade do blog: na da loja seria ruído. CLS vai
// multiplicado por 1000, para `metric_value` ser sempre inteiro. Sem o parâmetro
// `value`, de propósito: ele soma no "valor do evento" do GA4.
---

<script>
  import { onCLS, onINP, onLCP, type Metric } from 'web-vitals';
  import { GOOGLE_ANALYTICS_ID } from '../consts';

  type Gtag = (...args: unknown[]) => void;

  function send(metric: Metric) {
    const gtag = (window as unknown as { gtag?: Gtag }).gtag;
    if (typeof gtag !== 'function') return;

    gtag('event', 'web_vitals', {
      send_to: GOOGLE_ANALYTICS_ID,
      metric_name: metric.name,
      metric_value: Math.round(metric.name === 'CLS' ? metric.value * 1000 : metric.value),
      metric_rating: metric.rating,
      metric_id: metric.id,
    });
  }

  onLCP(send);
  onINP(send);
  onCLS(send);
</script>
