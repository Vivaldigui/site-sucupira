---
import { BLOG_SITE_URL, FIRST_PARTY_TRACKING_ENDPOINT } from '../consts';
import snSource from '../scripts/sn-tracking.js?raw';

// Registra a sessão e transfere visitante/origem para a loja com um passe temporário da API.
// O build verifica se a recuperação da sessão e a ligação entre domínios estão presentes.
// Fora de produção o script fica desligado; a API deve aceitar a origem deste blog.
const productionHost = new URL(BLOG_SITE_URL).hostname;
const config = `window.SN_TRACK = { endpoint: ${JSON.stringify(FIRST_PARTY_TRACKING_ENDPOINT)}, disabled: window.location.hostname !== ${JSON.stringify(productionHost)}, blogHost: ${JSON.stringify(productionHost)} };`;
---

<script is:inline set:html={`${config}
${snSource}`}></script>
