---
import { Image } from 'astro:assets';
import logoImage from '../../assets/favicon-logo-transparent.png';
import { BLOG_NAME, SALES_CTA_URL } from '../consts';
import StoreTopBar from './StoreTopBar.astro';
---

<StoreTopBar />

<header class="blog-header">
  <a href="/" class="logo-wrap" aria-label={`${BLOG_NAME} - início`}>
    <Image
      class="logo"
      src={logoImage}
      alt="Sucupira Naturale"
      width={52}
      height={52}
      loading="eager"
      decoding="async"
    />
    <div class="site-name">
      {BLOG_NAME}
      <span>por Sucupira Naturale</span>
    </div>
  </a>
  <nav class="header-links" aria-label="Navegação do site">
    <a href="/sobre/" class="header-link">Quem somos</a>
    <a href={SALES_CTA_URL} class="header-cta">Conhecer o produto</a>
  </nav>
</header>
