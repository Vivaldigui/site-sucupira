---
// Barra fixa do celular. Num artigo, texto e destino vêm do grupo dele
// (src/config/store-ads.ts); fora de artigo, vale o padrão.
import { SALES_CTA_URL } from '../consts';
import { STORE_AD_GROUPS, storeAdGroup, SENSITIVE_SLUGS } from '../config/store-ads';

interface Props {
  slug?: string;
}

const { slug } = Astro.props;
const group = slug ? storeAdGroup(slug) : undefined;
const sticky = group ? STORE_AD_GROUPS[group].sticky : { text: 'Sucupira Naturale', cta: 'Conhecer produto', url: SALES_CTA_URL };
---

{slug && !SENSITIVE_SLUGS.has(slug) && <div hidden data-posicao="barra-fixa" class="mobile-sticky-cta" aria-label="Conhecer o produto" data-criativo={`barra-${(group ?? 'padrao').toLowerCase()}-v2`}>
  <p>{sticky.text}</p>
  <a data-sn-cta="barra-fixa" href={sticky.url}>{sticky.cta}</a>
  <button type="button" class="mobile-sticky-close" aria-label="Fechar">×</button>
</div>}

<script>
  function init() {
    const bar=document.querySelector<HTMLElement>('.mobile-sticky-cta');
    const article=document.querySelector<HTMLElement>('.article-body');
    if(!bar || !article) return;
    const key='sn_barra_fechada_ate_v2'; let closed=false;
    try {closed=Number(localStorage.getItem(key))>Date.now();}catch{}
    const inView=new Set<Element>();
    const update=()=>{
      const bounds=article.getBoundingClientRect();
      const progress=Math.max(0,-bounds.top)/Math.max(1,bounds.height-window.innerHeight);
      bar.hidden=closed || progress<0.35 || inView.size>0;
    };
    // Sem observer, mantém a barra oculta; os outros CTAs continuam disponíveis.
    if(!('IntersectionObserver' in window)) return;
    const observer=new IntersectionObserver(entries=>{for(const entry of entries){
      if(entry.isIntersecting)inView.add(entry.target);else inView.delete(entry.target);
    }update();});
    document.querySelectorAll('.store-ad,.store-top-bar,.product-cta').forEach(el=>observer.observe(el));
    window.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);
    bar.querySelector('button')?.addEventListener('click',()=>{
      closed=true;update();try{localStorage.setItem(key,String(Date.now()+7*86400000));}catch{}
    });
    update();
  }
  init();
</script>
