---
// Barra fixa do celular. Num artigo, texto e destino vêm do grupo dele
// (src/config/store-ads.ts); fora de artigo, vale o padrão.
import { SALES_CTA_URL } from '../consts';
import { STORE_AD_GROUPS, storeAdGroup } from '../config/store-ads';

interface Props {
  slug?: string;
}

const { slug } = Astro.props;
const group = slug ? storeAdGroup(slug) : undefined;
const sticky = group ? STORE_AD_GROUPS[group].sticky : { text: 'Sucupira Naturale', cta: 'Conhecer produto', url: SALES_CTA_URL };
---

<div class="mobile-sticky-cta" aria-label="Conhecer o produto" data-criativo={`barra-${group ?? 'padrao'}`}>
  <p>{sticky.text}</p>
  <a href={sticky.url}>{sticky.cta}</a>
  <button type="button" class="mobile-sticky-close" aria-label="Fechar">×</button>
</div>

<script is:inline>
  (function () {
    var KEY = 'sn_barra_fechada';
    var bar = document.currentScript && document.currentScript.previousElementSibling;
    if (!bar || !bar.classList.contains('mobile-sticky-cta')) return;
    try {
      if (sessionStorage.getItem(KEY) === '1') bar.hidden = true;
    } catch (e) {}
    var close = bar.querySelector('.mobile-sticky-close');
    if (close) close.addEventListener('click', function () {
      bar.hidden = true;
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    });
  })();
</script>
